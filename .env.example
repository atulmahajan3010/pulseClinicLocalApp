# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctor_app

# JWT_SECRET is generated and stored automatically by the desktop application.

# Express API port (default: 3001)
PORT=3001

# WhatsApp Business Cloud API
# Create a Meta app and copy the permanent token + phone number ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
